{
  "name": "subscrio-payments",
  "version": "0.4.0",
  "description": "Payments extension for Subscrio — records Stripe invoice.payment_succeeded amounts via stripe.received.after",
  "author": "Subscrio Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subscrio/subscrio-extensions-payments.git"
  },
  "homepage": "https://github.com/subscrio/subscrio-extensions-payments#readme",
  "bugs": {
    "url": "https://github.com/subscrio/subscrio-extensions-payments/issues"
  },
  "keywords": [
    "subscrio",
    "payments",
    "stripe",
    "invoice",
    "subscription",
    "postgresql",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "subscrio": ">=0.4.0 <0.6.0"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "subscrio": "0.5.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
